generator client {
  provider             = "prisma-client-py"
  interface            = "sync"
  recursive_type_depth = "5"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id                Int      @id @default(autoincrement())
  outlet            String
  date              DateTime
  title             String
  url               String   @unique
  raw_html          String?
  text              String?
  clean_text        String?
  sentences         Json?
  entities          Json?
  entity_sentiments Json?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model Outlet {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  url        String
  rss_feeds  Json?
  created_at DateTime @default(now())
}

model ScrapeRunLog {
  id         Int      @id @default(autoincrement())
  started_at DateTime
  finished_at DateTime
  status     String
  error      String?
  log_lines  Json
  created_at DateTime @default(now())
}
